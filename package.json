{
  "name": "habayit-hashalem",
  "private": true,
  "homepage": "https://kingofscoot123-png.github.io/habayit-hashalem/",
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0",
    "dev:clean": "npx --yes kill-port 3000 && next dev --port 3000 --hostname 0.0.0.0",
    "dev:fresh": "npx --yes kill-port 3000 && npx --yes rimraf .next && next dev --port 3000 --hostname 0.0.0.0",
    "dev:tunnel": "npx --yes cloudflared tunnel --url http://127.0.0.1:3000",
    "build": "next build",
    "start": "next start --port 3000",
    "prod": "npm run build && npm run start"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "lucide-react": "^1.59.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
